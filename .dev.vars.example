# Copy to .dev.vars for local dev. Never commit .dev.vars.
APP_ORIGIN=https://localhost:5173
# Comma-separated extra origins to trust, for local dev only (for example a phone on the LAN).
EXTRA_ORIGINS=https://localhost:5173
# Any random string of 32+ characters, for example from `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-string
# A dummy value is fine locally; sending a code then fails with SEND_FAILED.
RESEND_API_KEY=re_placeholder
