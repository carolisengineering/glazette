{
  "name": "glazette",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glazette",
      "database_id": "a1c998ee-7e05-4900-982b-743c0d79f5cf",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "glazette-photos" }],
  "triggers": { "crons": ["17 8 * * *"] },
  "vars": {
    "APP_ORIGIN": "https://glazette.offhours.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
